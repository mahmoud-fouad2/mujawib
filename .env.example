# ─── Database ────────────────────────────────────────────────────────────────
# Neon pooled connection string. Must include sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 32   (minimum 32 characters)
BETTER_AUTH_SECRET="replace-with-a-32-character-minimum-secret"

# Both must be the app's public origin — same value in production.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Google sign-in (optional) ───────────────────────────────────────────────
# The Google button only renders when BOTH are set — no dead buttons.
# Authorised redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password recovery (optional until account emails are enabled).
RESEND_API_KEY=""
EMAIL_FROM="MUJAWIB <access@mujawib.ai>"

# ─── Protected customer data ────────────────────────────────────────────────
# Generate once per environment: openssl rand -base64 32
# Keep old keys during a future rotation until all v1 values are re-encrypted.
DATA_ENCRYPTION_KEY=""

# ─── Voice runtime (optional — console runs without these) ───────────────────
OPENAI_API_KEY=""
OPENAI_WEBHOOK_SECRET=""
# Optional pinned override for post-call summaries.
OPENAI_POST_CALL_MODEL="gpt-5.4-mini-2026-03-17"

# ─── Private call recordings (optional, S3-compatible / Cloudflare R2) ─────
# Disabled by default. Enable only after all five storage values are present,
# then verify real Put/Get/Delete access with: pnpm recordings:verify-storage
# R2 endpoint example: https://<account-id>.r2.cloudflarestorage.com
RECORDING_STORAGE_ENABLED="false"
RECORDING_STORAGE_ENDPOINT=""
RECORDING_STORAGE_REGION="auto"
RECORDING_STORAGE_BUCKET=""
RECORDING_STORAGE_ACCESS_KEY_ID=""
RECORDING_STORAGE_SECRET_ACCESS_KEY=""
# Hard safety ceiling per call. Range: 60–7200 seconds.
RECORDING_MAX_SECONDS="3600"

# ─── call-path runtime (all optional; defaults shown) ────────────────────────
# Set to "1" in production. Hands SIGTERM/SIGINT to server/runtime/lifecycle.ts
# instead of Next's own handler, which exits the moment the HTTP server closes.
# Without it, draining cannot run and every deploy cuts live calls dead.
# Leave unset locally so ctrl-c still stops the dev server immediately.
NEXT_MANUAL_SIG_HANDLE=""
# How long shutdown waits for calls to finish before handing them over.
# Keep it under the hosting platform's kill grace period. Default: 25000.
SHUTDOWN_DRAIN_TIMEOUT_MS=""
# Concurrent calls one process will carry before refusing with SIP 486.
# This protects the process; workspace.concurrentCallLimit is a per-client
# contract and does not bound the platform. Default: 25.
ACTIVE_REALTIME_CALL_LIMIT=""
# Connections reserved for the voice runtime, separate from the pool the
# console and portal share. Small on purpose. Default: 3.
DATABASE_REALTIME_POOL_MAX=""
# Existing deployments may keep the original private R2 names below instead.
# R2_PUBLIC_BASE_URL is deliberately ignored; playback stays behind MUJAWIB auth.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ─── Error tracking (optional) ────────────────────────────────────────────────
# Both point at the same Sentry project — the DSN is not a secret, only the
# NEXT_PUBLIC_ one ships to the browser. Unset means no Sentry SDK activity at
# all, server or client, same as leaving any other integration here empty.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Bot protection for the public contact form (optional) ─────────────────
# reCAPTCHA v3 (Google, https://www.google.com/recaptcha/admin). Verification
# is skipped silently when either is unset, same as every other optional
# integration here — the honeypot field and rate limit still apply on their own.
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ─── Twilio self-serve numbers (optional) ──────────────────────────────────
# Lets a client search/request a number from /portal/phone. Purchasing still
# requires an operator's approval in /console/phone/requests before any
# Twilio API call that spends money — see server/actions/twilio.ts.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
