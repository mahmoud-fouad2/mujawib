# Skip env validation for UI-only local preview (no Neon required)
SKIP_ENV_VALIDATION=true

# ─── Database (Neon recommended) ───────────────────────────────
# Create project at https://neon.tech → copy pooled connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (Better Auth) ────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32-char-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── OpenAI Realtime (Sprint 1) ────────────────────────────────
OPENAI_API_KEY=""
OPENAI_WEBHOOK_SECRET=""

# ─── Sideband WebSocket service ────────────────────────────────
REALTIME_SERVICE_URL="http://localhost:8787"

# Skip env validation during Docker/build if needed
# SKIP_ENV_VALIDATION=true
